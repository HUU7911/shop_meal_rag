# ===== App =====
APP_NAME=shop-meal-rag
APP_ENV=development            # development | docker | production
APP_PORT=8000
API_PREFIX=/api/v1/chatbot
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ===== Auth =====
# Chọn 1 trong 2: JWT_PUBLIC_KEY (PEM) hoặc JWT_JWKS_URL (Gateway/Auth service)
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=
# Chỉ bật true khi chatbot KHÔNG thể truy cập trực tiếp từ ngoài Gateway
TRUST_GATEWAY_USER_HEADER=false
ALLOW_GUEST=true               # cho phép khách chưa đăng nhập hỏi FAQ/chính sách
INTERNAL_API_KEY=change_internal_key   # bảo vệ endpoint /admin/*

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=shop_meal_chatbot
MYSQL_USER=rag_user
MYSQL_PASSWORD=change_rag_password
MYSQL_ROOT_PASSWORD=change_root_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_redis_password

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_qdrant_key
QDRANT_COLLECTION=shop_meal_knowledge     # alias trỏ tới shop_meal_knowledge_vN

# ===== Embedding / Rerank =====
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3               # xác nhận bằng eval trước khi chốt
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== Retrieval =====
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
RETRIEVAL_SCORE_THRESHOLD=0.35
HYBRID_ENABLED=true

# ===== LLM =====
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ===== Conversation =====
HISTORY_MAX_TURNS=6
HISTORY_MAX_TOKENS=1500
MESSAGE_MAX_LENGTH=1000
RATE_LIMIT_PER_MINUTE=20
HISTORY_RETENTION_DAYS=90

# ===== Shop Meal services =====
PRODUCT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
SERVICE_HTTP_TIMEOUT_SECONDS=5
KAFKA_BOOTSTRAP_SERVERS=              # để trống = tắt event-driven indexing
